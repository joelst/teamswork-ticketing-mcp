<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- Pins every package, transitive ones included, to the committed packages.lock.json; CI restores with locked mode,
         so a changed dependency graph fails the build instead of arriving silently. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Linux builds (the release executable and the container) don't need ICU, which minimal distributions and some
         WSL images lack. Nothing here is culture-sensitive: formatting and parsing use the invariant culture. Windows
         and macOS keep ICU, which .NET on Windows needs to look up IANA time zone names such as America/Chicago.
         Linux reads those from tzdata instead, so Linux still needs tzdata; the container's base image includes it. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <InvariantGlobalization Condition="$(RuntimeIdentifier.StartsWith('linux'))">true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
